# NCBI API Key — optional but recommended
# Get free key at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Secret key for JWT — CHANGE THIS to any long random string in production
SECRET_KEY=change-this-secret-key-in-production

# Token expiry: 10080 minutes = 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite database path (auto-created on first run)
DATABASE_URL=sqlite:///./regulome.db

# Max variants to process per upload
MAX_VARIANTS=100
